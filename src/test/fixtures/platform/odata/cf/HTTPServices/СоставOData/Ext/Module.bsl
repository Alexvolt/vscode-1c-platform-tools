// HTTP-сервис проверки состава стандартного интерфейса OData на платформе.
// POST /hs/odata-composition/run принимает тот же запрос, что служебная обработка
// ODataComposition, и отвечает тем же JSON. Серверные функции обработки
// (ВыполнитьЗапрос и её помощники) дописываются в конец модуля перед загрузкой
// конфигурации: так проверяется ровно тот код, который выполняет обработка.

Функция ЗапросPOST(Запрос)

	Попытка
		ТекстОтвета = ВыполнитьЗапрос(Запрос.ПолучитьТелоКакСтроку());
		Ответ = Новый HTTPСервисОтвет(200);
	Исключение
		ТекстОтвета = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Ответ = Новый HTTPСервисОтвет(500);
	КонецПопытки;

	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции
